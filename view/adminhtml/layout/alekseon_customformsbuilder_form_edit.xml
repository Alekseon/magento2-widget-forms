<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
        <css src="Alekseon_WidgetForms::css/frontend-view.css"/>
    </head>
    <body>
        <referenceBlock name="form_edit_tabs">
            <block class="Alekseon\WidgetForms\Block\Adminhtml\Form\Edit\Tab\WidgetSettings" name="form_widget_settings_tab">
                <block class="Alekseon\WidgetForms\Block\Adminhtml\Form\Edit\Tab\WidgetSettings\FrontendView"
                       name="form_widget_settings_frontend_view" as="form_after"/>
            </block>
            <action method="addTab">
                <argument name="name" xsi:type="string">form_widget_settings_tab</argument>
                <argument name="block" xsi:type="string">form_widget_settings_tab</argument>
            </action>
            <block class="Alekseon\WidgetForms\Block\Adminhtml\Form\Edit\Tab\NewsletterSettings" name="newsletter_settings_tab"/>
            <action method="addTab">
                <argument name="name" xsi:type="string">newsletter_settings_tab</argument>
                <argument name="block" xsi:type="string">newsletter_settings_tab</argument>
            </action>
        </referenceBlock>
    </body>
</page>
